# Server
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Rate limit (requests per window)
RATE_LIMIT_MAX=200
RATE_LIMIT_TIME_WINDOW_MS=60000

# Supabase (optional — if missing, API uses in-memory stores + Bearer demo)
# Prod Neuropi: https://hcbqrdxonbezscgzeyyo.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS — comma-separated origins, or * for open mobile dev
CORS_ORIGIN=*
